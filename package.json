{
  "name": "be-better",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "tsx watch --env-file-if-exists=.env apps/api/src/index.ts",
    "build": "npm run typecheck && vite build && esbuild apps/api/src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/api/index.js",
    "start": "node --env-file-if-exists=.env dist/api/index.js",
    "service:install": "node scripts/install-macos-service.mjs",
    "health": "node scripts/check-server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "backup": "tsx --env-file-if-exists=.env apps/api/src/backup.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.72",
    "@ai-sdk/openai": "^4.0.84",
    "@ai-sdk/react": "^4.0.0",
    "@assistant-ui/ai-sdk": "^0.0.11",
    "@assistant-ui/react": "^0.15.25",
    "@hono/node-server": "^1.19.0",
    "@openai/codex": "0.160.1",
    "ai": "^7.0.128",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "fast-xml-parser": "^5.11.2",
    "fit-file-parser": "^6.1.2",
    "hono": "^4.10.0",
    "idb": "^8.0.4",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "sharp": "^0.35.5",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "esbuild": "^0.28.2",
    "prettier": "3.6.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.0"
  }
}
