# Default: official local Codex app-server, using your ChatGPT subscription.
# Sign in in the PWA's Settings. No OpenAI API key is needed for this path.
AI_PROVIDER=codex
CODEX_MODEL=gpt-6.1-sol
# Optional isolated credential directory; default ~/.be-better/codex.
# BE_BETTER_CODEX_HOME=
# CODEX_BINARY= (defaults to the pinned node_modules/.bin/codex)

# Optional separately billed API providers: openai or anthropic.
# AI_MODEL=gpt-6-luna
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Leave empty for localhost + private Tailscale Serve. Required for direct network binding.
AUTH_TOKEN=
HOST=127.0.0.1
PORT=3001
DATABASE_PATH=./data/coach.sqlite
ATHLETE_TIMEZONE=America/Chicago
# BLOB_DIRECTORY= (defaults to a sibling <database-name>-blobs directory)

# Optional Intervals.icu workout imports and analysis. Keep both values on the server.
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=
